omo-wrap { position: relative; width: 240px; }\n    #promo-check { border: 1px solid #789; min-height: 20px; }\n    #promo-icon { position: absolute; z-index: 2; left: 104px; top: 8px; pointer-events: auto; }\n    #status { color: #285b7b; font-weight: bold; }\n  ", "\n", "BODY", "HEADER", "A", "href", "/", "inline", "pointer", "Acme Settings", "MAIN", "\n    ", "H1", "Settings", "SECTION", "\n      ", "H2", "Preferences", "DIV", "id", "tos-check", "role", "checkbox", "tabindex", "0", "aria-checked", "false", "Accept the terms of service", "wifi-switch", "switch", "true", "Wi-Fi", "Plan", "radiogroup", "aria-label", "\n        ", "plan-basic", "radio", "Basic", "plan-pro", "Pro", "plan-max", "Max", "Promotions", "promo-wrap", "promo-check", "Email me promotions", "I", "promo-icon", "aria-hidden", "\u2709", "P", "status", "No settings have changed.", "SCRIPT", "\n    const status = document.getElementById('status');\n    function toggle(widget, label) {\n      const on = widget.getAttribute('aria-checked') !== 'true';\n      widget.setAttribute('aria-checked', String(on));\n      status.textContent = label + ': ' + (on ? 'on.' : 'off.');\n      return on;\n    }\n    function wireToggle(id, label, words) {\n      const widget = document.getElementById(id);\n      const change = () => {\n        const on = toggle(widget, label);\n        if (words) status.textContent = label + ': ' + (on ? words[0] : words[1]) + '.';\n      };\n      widget.addEventListener('click', change);\n      widget.addEventListener('keydown', (event) => {\n        if (event.key === ' ' || event.key === 'Enter') { event.preventDefault(); change(); }\n      });\n    }\n    wireToggle('tos-check', 'Terms', ['accepted', 'not accepted']);\n    wireToggle('wifi-switch', 'Wi-Fi');\n    const radios = [...document.querySelectorAll('[role=radio]')];\n    function selectPlan(radio) {\n      radios.forEach((item) => item.setAttribute('aria-checked', String(item === radio)));\n      status.textContent = 'Plan: ' + radio.textContent + '.';\n    }\n    radios.forEach((radio) => {\n      radio.addEventListener('click', () => selectPlan(radio));\n      radio.addEventListener('keydown', (event) => {\n        if (event.key === ' ' || event.key === 'Enter') { event.preventDefault(); selectPlan(radio); }\n      });\n    });\n    const promo = document.getElementById('promo-check');\n    function togglePromo() { toggle(promo, 'Promotions'); }\n    document.getElementById('promo-wrap').addEventListener('click', togglePromo);\n    promo.addEventListener('keydown', (event) => {\n      if (event.key === ' ' || event.key === 'Enter') { event.preventDefault(); togglePromo(); }\n    });\n  ", "\n\n\n"]}